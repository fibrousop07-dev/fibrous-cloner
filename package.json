{
  "name": "fibrous-cloner",
  "version": "1.0.0",
  "description": "Local website cloner with a desktop control panel and CLI. Download public HTML, CSS, JavaScript, assets and API responses; preview website copies on localhost.",
  "type": "module",
  "bin": {
    "fibrous-cloner": "sitecloner.mjs"
  },
  "scripts": {
    "start": "node ui.mjs",
    "installer": "powershell -ExecutionPolicy Bypass -File installer/build.ps1",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/cloner.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "site-cloner",
    "website-cloner",
    "website-downloader",
    "offline-browser",
    "website-archiver",
    "localhost",
    "nodejs",
    "frontend",
    "cli",
    "static-site",
    "api-snapshot"
  ],
  "homepage": "https://fibrousop07-dev.github.io/fibrous-cloner/",
  "repository": {
    "type": "git",
    "url": "https://github.com/fibrousop07-dev/fibrous-cloner.git"
  },
  "bugs": {
    "url": "https://github.com/fibrousop07-dev/fibrous-cloner/issues"
  },
  "license": "MIT",
  "author": "fibrousop07-dev"
}
